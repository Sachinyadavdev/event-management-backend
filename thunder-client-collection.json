          "method": "PUT",
          "url": "{{base_url}}/api/events/1",
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer {{admin_token}}"
            }
          ],
          "body": {
            "type": "json",
            "raw": "{\n  \"event_title\": \"Updated Event Title\",\n  \"max_attendees\": 250\n}"
          }
        }
