{
  "clientName": "Thunder Client",
  "collectionName": "ISACA Silicon Valley API",
  "collectionId": "isaca-sv-api",
  "dateExported": "2025-10-25",
  "version": "1.0",
  "folders": [
    {
      "id": "auth-folder",
      "name": "Authentication",
      "requests": [
        {
          "name": "Register User",
          "method": "POST",
          "url": "{{base_url}}/api/auth/register",
          "body": {
            "type": "json",
            "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Test123\",\n  \"phone\": \"1234567890\",\n  \"company\": \"Tech Corp\",\n  \"position\": \"Developer\",\n  \"department\": \"IT\",\n  \"location\": \"San Jose, CA\"\n}"
          }
        },
        {
          "name": "Login User",
          "method": "POST",
          "url": "{{base_url}}/api/auth/login",
          "body": {
            "type": "json",
            "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Test123\"\n}"
          }
        },
        {
          "name": "Login Admin",
          "method": "POST",
          "url": "{{base_url}}/api/auth/login",
          "body": {
            "type": "json",
            "raw": "{\n  \"email\": \"admin@isacasv.org\",\n  \"password\": \"Admin@123\"\n}"
          }
        },
        {
          "name": "Get My Profile",
          "method": "GET",
          "url": "{{base_url}}/api/auth/me",
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer {{token}}"
            }
          ]
        },
        {
          "name": "Update Profile",
          "method": "PUT",
          "url": "{{base_url}}/api/auth/profile",
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "body": {
            "type": "json",
            "raw": "{\n  \"full_name\": \"John Updated\",\n  \"phone\": \"9876543210\"\n}"
          }
        },
        {
          "name": "Change Password",
          "method": "PUT",
          "url": "{{base_url}}/api/auth/password",
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "body": {
            "type": "json",
            "raw": "{\n  \"currentPassword\": \"Test123\",\n  \"newPassword\": \"NewTest123\"\n}"
          }
        }
      ]
    },
